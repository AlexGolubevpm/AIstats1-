# Copy to /opt/tubestat/.env on the server. Never commit real values.
APP_DOMAIN=stats.example.com          # or :80 until DNS is ready
APP_URL=https://stats.example.com     # links in MCP answers
POSTGRES_PASSWORD=                    # openssl rand -hex 24
COMPOSE_PROFILES=worker               # runs the ingest worker (BullMQ)

# Access
APP_PASSWORD=                         # login password; can be changed later in Настройки → Доступ
COOKIE_SECURE=1                       # set to 1 once the site is served over HTTPS
MCP_TOKEN=                            # optional bootstrap token; normally issued in Настройки → Доступ

# AdSpyglass (ADOK) — requests are throttled, see docs/architecture/08-backend.md#asg-limits
ASG_API_URL=https://api.adok.ai/api
ASG_AUTH_EMAIL=
ASG_AUTH_TOKEN=
ASG_MIN_INTERVAL_MS=5000              # pause between requests
ASG_DAILY_BUDGET=300                  # max requests per UTC day
ASG_RESTATE_DAYS=2                    # nightly job re-reads this many past days

# Yandex Metrika
METRIKA_TOKEN=

# Raw API responses: S3 (Timeweb S3 / R2) when set, otherwise the raw_data volume (/data/raw)
S3_ENDPOINT=
S3_BUCKET=tubestat-raw
S3_ACCESS_KEY=
S3_SECRET_KEY=

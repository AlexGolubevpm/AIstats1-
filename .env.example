# Copy to /opt/tubestat/.env on the server. Never commit real values.
APP_DOMAIN=stats.example.com          # or :80 until DNS is ready
POSTGRES_PASSWORD=                    # openssl rand -hex 24
# COMPOSE_PROFILES=worker             # enable when the worker is shipped

# AdSpyGlass
ASG_API_URL=https://api.adok.ai/api
ASG_AUTH_EMAIL=
ASG_AUTH_TOKEN=

# Yandex Metrika
METRIKA_TOKEN=

# Raw API responses (Timeweb S3 or Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=tubestat-raw
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Access
APP_PASSWORD=
MCP_TOKEN=
